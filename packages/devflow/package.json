{
  "name": "create-devflow",
  "version": "0.1.1",
  "description": "CLI that generates reproducible developer workflows for TypeScript, React, Node.js and monorepos: ESLint, Prettier, Husky, Vitest, GitHub Actions, Docker and security configs in one command.",
  "type": "module",
  "bin": {
    "create-devflow": "./bin/devflow.js",
    "devflow": "./bin/devflow.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node bin/devflow.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "devflow",
    "create-devflow",
    "devflow-cli",
    "cli",
    "scaffolding",
    "husky",
    "eslint",
    "prettier",
    "commitlint",
    "vitest",
    "github-actions",
    "ci",
    "cd",
    "docker",
    "monorepo",
    "turborepo",
    "developer-experience",
    "developer-workflow"
  ],
  "author": "disin8",
  "license": "MIT",
  "homepage": "https://dev-flow.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/disin8/devflow.git"
  },
  "bugs": {
    "url": "https://github.com/disin8/devflow/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "detect-indent": "^7.0.1",
    "ora": "^8.2.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
