{
  "name": "create-devflow",
  "version": "0.1.0",
  "description": "CLI utility to bootstrap a complete DevFlow in any repo: Git hooks, commit convention, lint/format, tests, typecheck, CI/CD, releases, security, Docker, monorepo support",
  "type": "module",
  "bin": {
    "create-devflow": "./bin/devflow.js",
    "devflow": "./bin/devflow.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node bin/devflow.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "devflow",
    "cli",
    "scaffolding",
    "husky",
    "eslint",
    "prettier",
    "commitlint",
    "ci",
    "cd",
    "monorepo",
    "developer-experience"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "detect-indent": "^7.0.1",
    "ora": "^8.2.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^4.0.18",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
